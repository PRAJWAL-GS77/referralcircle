# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/referralcircle?retryWrites=true&w=majority

# JWT Secret for signing session tokens (Generate a random string, e.g. run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Enable Demo Student login endpoint in production/staging (true/false)
ENABLE_DEMO_LOGIN=true
